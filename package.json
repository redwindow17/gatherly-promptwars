{
  "name": "gatherly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.ui-tests.json",
    "format:check": "prettier --check src worker tests package.json tsconfig*.json vite.config.ts wrangler.jsonc index.html README.md",
    "types": "wrangler types worker/env.d.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
